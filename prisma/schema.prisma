// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... User and Account models are fine ...

model User {
  id    String @id @default(cuid())
  email String @unique

  username String? @unique
  name     String?
  image    String?

  password String?

  role UserRoleEnum[] @default([APPLICANT])

  // A recruiter belongs to one company
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  
  refresh_token     String? 
  access_token      String?
  id_token          String?

  expires_at        Int?
  token_type        String?
  scope             String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model Company {
  id String @id @default(cuid())

  name String 
  // Make slug unique to prevent conflicts
  slug String @unique

  image String?
  coverImage String?
  location String
  description String

  websiteUrl  String?

  recruiters User[]
  jobs Job[]

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id String @id @default(cuid())

  title            String
  description      String?

  responsibilities String[]
  qualifications   String[]
  benefits         String[]

  skills           String[]
  workArrangement  WorkArrangement @default(ON_SITE)
  workSchedule     String?

  location         String
  jobType          JobType
  experienceLevel  ExperienceLevel
  salaryMin        Int?
  salaryMax        Int?
  department       String?
  isActive         Boolean         @default(true)


  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  // A job has a list of questions through the join table
  questions QuestionOnJob[]

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Application {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  job    Job    @relation(fields: [jobId], references: [id])
  jobId  String

  status  ApplicationStatus @default(SUBMITTED)

  // Each application will have its own set of answers
  answers ApplicationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
}




model Question {
  id String @id @default(cuid())

  question String
  type     QuestionTypeEnum
  options  String[] // For MULTIPLE_CHOICE, CHECKBOX, etc.

  // The company that created and owns this question
  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  // A question can be used on many jobs through the join table
  jobs QuestionOnJob[]
  
  // A question can be answered in many applications
  answers ApplicationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionOnJob {
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Extra metadata about the relationship
  order      Int     @default(0) // To control the display order of questions for a specific job
  isRequired Boolean @default(true)

  // A question can only appear once per job
  @@id([jobId, questionId])
}

model ApplicationAnswer {
  id     String @id @default(cuid())
  answer String[]

  // The answer is now linked to a specific Application, not just a user
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // The question being answered
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  // A question should only be answered once per application
  @@unique([applicationId, questionId])
}


enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  INTERNSHIP
  ENTRY_LEVEL
  ASSOCIATE
  MID_LEVEL
  SENIOR
  STAFF
  PRINCIPAL
}

enum UserRoleEnum {
  APPLICANT
  RECRUITER
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
  HIRED
}

enum WorkArrangement {
  ON_SITE
  HYBRID
  REMOTE
}

enum QuestionTypeEnum {
TEXT
MULTIPLE_CHOICE
NUMBER
CHECKBOX
TRUE_OR_FALSE


}